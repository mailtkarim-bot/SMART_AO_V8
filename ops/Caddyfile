{$SMART_AO_PUBLIC_HOST} {
    encode zstd gzip

    log {
        output file /var/log/caddy/access.log {
            roll_size 50MiB
            roll_keep 5
            roll_keep_for 336h
        }
        format filter {
            wrap json
            fields {
                request>uri query delete
                request>headers>Authorization delete
                request>headers>Cookie delete
            }
        }
    }

    request_body {
        max_size 150MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; frame-ancestors 'none'"
        -Server
    }

    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }

    @health path /healthz /healthz/*
    handle @health {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:8080
    }
}
