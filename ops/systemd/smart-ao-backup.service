[Unit]
Description=SMART AO PostgreSQL and private volume backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/smart-ao
ExecStart=/opt/smart-ao/ops/backup-preprod.sh
User=root
UMask=0077
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/opt/smart-ao
ReadWritePaths=/var/backups/smart-ao
