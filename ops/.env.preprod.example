# Copy to ops/.env.preprod on the VPS. Never commit the copied file.
# Generate every password/key with a password manager or: openssl rand -hex 32
SMART_AO_ENV=preproduction
SMART_AO_LOG_LEVEL=INFO
SMART_AO_PUBLIC_HOST=ao.example.invalid
SMART_AO_JWT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SMART_AO_JWT_ISSUER=smart-ao-preprod
SMART_AO_JWT_AUDIENCE=smart-ao-web
# Set to 1 only for a reviewed first deployment against an empty database.
# SMART_AO_ALLOW_EMPTY_BACKUP=1

POSTGRES_DB=smart_ao
POSTGRES_USER=smart_ao_app
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
PGPASSWORD=REPLACE_WITH_A_RANDOM_SECRET
SMART_AO_DATABASE_URL=postgresql+psycopg://smart_ao_app@postgres:5432/smart_ao

SMART_AO_DCE_QUARANTINE_ROOT=/var/lib/smart_ao/dce-quarantine
SMART_AO_CLAMD_HOST=clamav
SMART_AO_CLAMD_PORT=3310
SMART_AO_CLAMD_TIMEOUT_SECONDS=30

SMART_AO_RETENTION_BATCH_SIZE=50
SMART_AO_RETENTION_LEASE_SECONDS=120
SMART_AO_RETENTION_POLL_SECONDS=30

# Backups hors VPS : le répertoire doit être sur un volume chiffré et transféré par un opérateur.
SMART_AO_BACKUP_DIR=/var/backups/smart-ao
SMART_AO_BACKUP_RETENTION_DAYS=30
SMART_AO_BACKUP_REQUIRE_FRESH=1
SMART_AO_MAX_BACKUP_AGE_HOURS=26

# Rotation bornée des journaux Docker json-file.
SMART_AO_LOG_MAX_SIZE=50m
SMART_AO_LOG_MAX_FILES=5
SMART_AO_LOG_RETENTION_DAYS=14

# Rotation JWT : la rotation effective se fait par release contrôlée et invalidation planifiée,
# car cette version expose une seule clé active. Ne jamais mettre une seconde clé dans Git.
SMART_AO_JWT_KEY_ROTATION_ID=preprod-2026-08
SMART_AO_JWT_KEY_ROTATION_OVERLAP_HOURS=0

# Limitation progressive anti-brute-force, partagée par login et refresh dans ce processus.
SMART_AO_LOGIN_MAX_FAILURES=5
SMART_AO_LOGIN_FAILURE_WINDOW_SECONDS=900
SMART_AO_LOGIN_BASE_LOCKOUT_SECONDS=30
SMART_AO_LOGIN_MAX_LOCKOUT_SECONDS=900
