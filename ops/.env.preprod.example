# Copy to ops/.env.preprod on the VPS. Never commit the copied file.
# Generate every password/key with a password manager or: openssl rand -hex 32
SMART_AO_ENV=preproduction
SMART_AO_LOG_LEVEL=INFO
SMART_AO_PUBLIC_HOST=ao.example.invalid

POSTGRES_DB=smart_ao
POSTGRES_USER=smart_ao_app
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
PGPASSWORD=REPLACE_WITH_A_RANDOM_SECRET
SMART_AO_DATABASE_URL=postgresql+psycopg://smart_ao_app@postgres:5432/smart_ao

SMART_AO_DCE_QUARANTINE_ROOT=/var/lib/smart_ao/dce-quarantine
SMART_AO_CLAMD_HOST=clamav
SMART_AO_CLAMD_PORT=3310
SMART_AO_CLAMD_TIMEOUT_SECONDS=30

SMART_AO_RETENTION_BATCH_SIZE=50
SMART_AO_RETENTION_LEASE_SECONDS=120
SMART_AO_RETENTION_POLL_SECONDS=30
