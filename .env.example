# Development only. Do not commit a real .env file.
SMART_AO_ENV=development
SMART_AO_LOG_LEVEL=INFO
SMART_AO_DATABASE_URL=postgresql+psycopg://smart_ao:smart_ao@postgres:5432/smart_ao
POSTGRES_DB=smart_ao
POSTGRES_USER=smart_ao
POSTGRES_PASSWORD=smart_ao

# DCE-UPLOAD-01: backend-private quarantine and Docker-internal ClamAV only.
SMART_AO_DCE_QUARANTINE_ROOT=/var/lib/smart_ao/dce-quarantine
SMART_AO_CLAMD_HOST=clamav
SMART_AO_CLAMD_PORT=3310
SMART_AO_CLAMD_TIMEOUT_SECONDS=30
