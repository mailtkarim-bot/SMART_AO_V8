# Development only. Do not commit a real .env file.
SMART_AO_ENV=development
SMART_AO_LOG_LEVEL=INFO
SMART_AO_DATABASE_URL=postgresql+psycopg://smart_ao:smart_ao@postgres:5432/smart_ao
SMART_AO_POSTGRES_HOST_PORT=5432
# Development-only key; never reuse it in preproduction or production.
SMART_AO_JWT_SIGNING_KEY=local-development-signing-key-change-me-0123456789
POSTGRES_DB=smart_ao
POSTGRES_USER=smart_ao
POSTGRES_PASSWORD=smart_ao

# DCE-UPLOAD-01: backend-private quarantine and Docker-internal ClamAV only.
SMART_AO_DCE_QUARANTINE_ROOT=/var/lib/smart_ao/dce-quarantine
SMART_AO_DCE_MAX_BYTES=150000000
SMART_AO_CLAMD_HOST=clamav
SMART_AO_CLAMD_PORT=3310
SMART_AO_CLAMD_TIMEOUT_SECONDS=30

# RAG local BGE : désactivé par défaut ; le modèle doit être préchargé localement.
SMART_AO_INSTALL_RAG=0
SMART_AO_RAG_ENABLED=0
SMART_AO_RAG_INDEXING_ENABLED=0
SMART_AO_BGE_MODEL_ID=BAAI/bge-m3
SMART_AO_BGE_CACHE_DIR=/var/lib/smart_ao/models
SMART_AO_BGE_LOCAL_FILES_ONLY=1
SMART_AO_INSTALL_DOCUMENT_ADVANCED=0
SMART_AO_INSTALL_CONNECTORS=0
SMART_AO_INSTALL_NOTIFICATIONS=0
SMART_AO_INSTALL_CALENDAR=0
SMART_AO_ADVANCED_EXTRACTION_ENABLED=0

# S3/MinIO privé pour les documents générés : désactivé par défaut.
SMART_AO_OBJECT_STORAGE_ENABLED=0
SMART_AO_OBJECT_STORAGE_BUCKET=
SMART_AO_OBJECT_STORAGE_ENDPOINT_URL=
SMART_AO_OBJECT_STORAGE_REGION=
SMART_AO_OBJECT_STORAGE_SSE=AES256

# Read-only INSEE Sirene enrichment; disabled by default. Token is injected at runtime only.
SMART_AO_INSEE_ENABLED=0
SMART_AO_INSEE_API_TOKEN=
SMART_AO_INSEE_BASE_URL=https://api.insee.fr/api-sirene/3.11
SMART_AO_INSEE_TIMEOUT_SECONDS=5

# SMTP notifications for export status; disabled by default and never carries documents or amounts.
SMART_AO_SMTP_ENABLED=0
SMART_AO_SMTP_HOST=
SMART_AO_SMTP_PORT=587
SMART_AO_SMTP_FROM=
SMART_AO_SMTP_USERNAME=
SMART_AO_SMTP_PASSWORD=
SMART_AO_SMTP_USE_TLS=0
SMART_AO_SMTP_START_TLS=
SMART_AO_SMTP_TIMEOUT_SECONDS=10
SMART_AO_SMTP_TO=
SMART_AO_SMTP_BATCH_SIZE=50
SMART_AO_SMTP_LEASE_SECONDS=120
SMART_AO_SMTP_POLL_SECONDS=30

# HTTP signature callbacks: provider and HMAC secret are runtime-only; empty disables the routes.
SMART_AO_SIGNATURE_PROVIDER=
SMART_AO_SIGNATURE_CALLBACK_SECRET=

# Local ICS calendar export; disabled by default and no remote calendar synchronization.
SMART_AO_CALENDAR_ENABLED=0

# BOAMP public notice search; disabled by default and limited to an allowlisted projection.
SMART_AO_BOAMP_ENABLED=0
SMART_AO_BOAMP_BASE_URL=https://www.boamp.fr/api/explore/v2.1/catalog/datasets/boamp/records
SMART_AO_BOAMP_TIMEOUT_SECONDS=5

# DCE-RETENTION-01: deterministic worker for private expired/rejected upload deletion.
SMART_AO_RETENTION_BATCH_SIZE=50
SMART_AO_RETENTION_LEASE_SECONDS=120
SMART_AO_RETENTION_POLL_SECONDS=30
SMART_AO_OUTBOX_MAX_ATTEMPTS=10
